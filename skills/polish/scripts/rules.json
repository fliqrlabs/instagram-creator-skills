  "tells": {
    "not-just-x-its-y": "(?i)\\b(it'?s|this is|that'?s) not (just|only) [^.\\n]{1,40}[,;] (it'?s|this is)",
    "rule-of-three": "(?i)\\b\\w+, \\w+,? and \\w+\\.\\s*$",
    "emoji-bullets": "^(\\s*[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF]\\s+\\S.*\\n){3,}",
    "shouted-words": "\\b[A-Z]{3,}\\b \\b[A-Z]{3,}\\b \\b[A-Z]{3,}\\b",
    "rhetorical-setup": "(?i)^(the result\\?|the best part\\?|here'?s the thing:|here'?s the kicker|plot twist:)",
    "colon-reveal-chain": "(:\\s*\\w[^.\\n]*){3,}",
    "hashtag-wall": "(#\\w+\\s*){6,}"
  },
